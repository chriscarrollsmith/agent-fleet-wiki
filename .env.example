# Copy to .env and fill in the values.
# One working copy deploys one wiki. See docs/provision.md.
AWS_PROFILE=fleet-coordinator
AWS_DEFAULT_REGION=us-east-1
BUCKET=your-unique-bucket-name
ADMIN_EMAIL=you@example.com

# Distinct per wiki in the same AWS account. The defaults collide with an
# existing deploy: KEY_NAME is the EC2 key pair and security group, and
# IAM_USER is the attachment user (reusing it rewrites that user's bucket).
# KEY_NAME=bookstack
# IAM_USER=bookstack-attachments

# ADMIN_PASSWORD is generated and appended by deploy/08-tls-admin.sh.
# After deploy, set BOOKSTACK_URL=https://<HOST> for deploy/create-user.sh.
# HOST is written to deploy/state.env as <elastic-ip>.sslip.io.

# Infisical machine identity created under the project's Access Control.
# Used by deploy/sync-infisical-users.sh and deploy/create-user.sh --identity.
# Credentials are stored in the dev environment at /users/<identity>.
# INFISICAL_PROJECT_ID=
# INFISICAL_CLIENT_ID=
# INFISICAL_CLIENT_SECRET=
